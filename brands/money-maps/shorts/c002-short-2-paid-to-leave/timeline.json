      "lead": 0.15,
      "tail": 0.35,
      "min": 3.0
    },
    {
      "id": "s3",
      "lines": [
        "Planners expected about ten thousand four hundred households to leave. Only about four thousand five hundred did."
      ],
      "music": "reveal",
      "sfx": [
        {
          "type": "pop",
          "at": 2.4,
