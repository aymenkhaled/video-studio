      "id": "s1",
      "lines": [
        "The World Bank lent Russia eighty million dollars to help people leave the frozen north. Most of them stayed."
      ],
      "music": "build",
      "sfx": [
        {
          "type": "riser",
          "at": 0.0,
          "duration": 2.5,
          "gain": 0.18
