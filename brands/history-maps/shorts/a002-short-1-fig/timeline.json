      "tail": 0.35,
      "min": 3.0
    },
    {
      "id": "s3",
      "lines": [
        "He found full markets, busy harbours, and a city getting rich again."
      ],
      "music": "tension",
      "sfx": [
        {
          "type": "crowd",
          "at": 0.3,
          "duration": 2.5,
          "gain": 0.14
