    },
    {
      "id": "s2",
      "lines": [
        "Around one hundred fifty-three B C, the Roman senator Cato visited Carthage. Rome had beaten it fifty years earlier."
      ],
      "music": "tension",
      "sfx": [
        {
          "type": "whoosh",
          "at": 0.05,
          "duration": 0.6,
          "gain": 0.25
